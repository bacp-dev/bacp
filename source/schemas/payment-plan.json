{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bacp.dev/schemas/payment-plan.json",
  "title": "PaymentPlan (split and multi-tender)",
  "description": "How one accepted all_in_total is paid: several tenders now (gift card + UPI) and/or tranches over time (token advance + loan + balance). One closed payment mandate and one Receipt per tender. Step-up and AFA are evaluated on the plan total, never per tender.",
  "type": "object",
  "required": [
    "plan_id",
    "checkout_hash",
    "all_in_total",
    "tenders",
    "refund_allocation"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^plan_[A-Za-z0-9]{8,40}$"
    },
    "checkout_hash": {
      "$ref": "common.json#/$defs/Hash",
      "description": "Hash of the BPP-signed quote (the checkout), the same for every tender. It is not the accepted offer_hash."
    },
    "all_in_total": {
      "$ref": "common.json#/$defs/Amount"
    },
    "tenders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "tender_id": {
            "type": "string",
            "pattern": "^tdr_[A-Za-z0-9]{6,40}$"
          },
          "handler": {
            "$ref": "common.json#/$defs/HandlerRef"
          },
          "amount": {
            "$ref": "common.json#/$defs/PositiveAmount",
            "description": "Greater than zero, even when the tenders sum to the total."
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "description": "Capture order. Stored-value tenders first."
          },
          "tranche_id": {
            "type": "string",
            "description": "TermSheet payment.schedule tranche this tender pays."
          },
          "presence": {
            "$ref": "common.json#/$defs/Presence"
          },
          "closed_payment_mandate_ref": {
            "type": "string"
          },
          "auth_binding_type": {
            "type": "string"
          },
          "rail_ref": {
            "type": "string"
          },
          "funding": {
            "enum": [
              "debit",
              "credit",
              "prepaid",
              "cash",
              "voucher",
              "loan",
              "cbdc",
              "trade_credit"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "held",
              "captured",
              "failed",
              "released",
              "refunded",
              "partially_refunded"
            ]
          },
          "receipt_id": {
            "type": "string"
          }
        },
        "required": [
          "tender_id",
          "handler",
          "amount",
          "sequence",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "refund_allocation": {
      "enum": [
        "lifo",
        "pro_rata",
        "tender_specific"
      ],
      "description": "Default lifo: reverse capture order, each tender back to its own source (PA MD 10(f), PPI MD 14.3)."
    },
    "atomicity": {
      "const": "saga",
      "description": "Hold or capture in sequence. On a later failure, release or refund earlier tenders to source."
    },
    "afa_evaluated_on": {
      "const": "plan_total"
    }
  },
  "additionalProperties": false
}
