{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bacp.dev/schemas/agent-credential.json",
  "title": "AgentCredential",
  "description": "Claims of an SD-JWT VC (vct in.bacp.agent.1) issued by a registry-accredited issuer to an agent operated by a registered legal entity and bound to a BAP subscriber.",
  "type": "object",
  "required": [
    "vct",
    "iss",
    "sub",
    "iat",
    "exp",
    "operator",
    "bap",
    "agent",
    "cnf",
    "purposes",
    "disclosure",
    "status"
  ],
  "properties": {
    "vct": {
      "const": "in.bacp.agent.1"
    },
    "iss": {
      "type": "string",
      "format": "uri",
      "description": "Issuer: ONDC registry / DeDi record or accredited issuer"
    },
    "sub": {
      "type": "string",
      "description": "Agent id, e.g. did:web:agents.example.in:krishi-voice or urn:bacp:agent:..."
    },
    "iat": {
      "type": "integer"
    },
    "exp": {
      "type": "integer",
      "description": "<= iat + 180 days (REQ-116 rotation)"
    },
    "operator": {
      "type": "object",
      "required": [
        "legal_name",
        "entity_id",
        "grievance_officer"
      ],
      "properties": {
        "legal_name": {
          "type": "string"
        },
        "entity_id": {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "enum": [
                "CIN",
                "LLPIN",
                "GSTIN",
                "PAN"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        "grievance_officer": {
          "type": "object",
          "required": [
            "name",
            "email"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "phone": {
              "type": "string"
            }
          }
        },
        "incident_contact": {
          "type": "string",
          "format": "email"
        },
        "ai_inventory_ref": {
          "type": "string",
          "format": "uri",
          "description": "FREE-AI Rec 23 inventory entry"
        }
      }
    },
    "bap": {
      "type": "object",
      "required": [
        "subscriber_id",
        "ukid"
      ],
      "properties": {
        "subscriber_id": {
          "type": "string",
          "description": "ONDC/Beckn bap_id (FQDN)"
        },
        "ukid": {
          "type": "string"
        }
      }
    },
    "agent": {
      "type": "object",
      "required": [
        "class",
        "model_family",
        "build"
      ],
      "properties": {
        "class": {
          "enum": [
            "shopping",
            "voice_shopping",
            "assisted",
            "sub_agent"
          ]
        },
        "model_family": {
          "type": "string"
        },
        "build": {
          "type": "string",
          "description": "Release or build hash of the agent runtime"
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/Channel"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uap_agent_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Reserved for an NPCI UAP registry id once published"
        }
      }
    },
    "cnf": {
      "type": "object",
      "required": [
        "jwk"
      ],
      "properties": {
        "jwk": {
          "$ref": "common.json#/$defs/Jwk"
        }
      },
      "description": "RFC 7800 key binding. The same key signs RFC 9421 requests and KB-JWTs that close open mandates."
    },
    "purposes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "bacp-browse",
          "bacp-pay",
          "bacp-post-order",
          "bacp-negotiate"
        ]
      },
      "description": "RFC 9421 signature tags this key may use (Visa TAP-style browse/pay split). v1 adds bacp-negotiate (firm offers, ACCEPT, bids, RFQ awards; design brief v1 deltas)."
    },
    "disclosure": {
      "type": "object",
      "required": [
        "ai_notice",
        "human_handoff_url"
      ],
      "properties": {
        "ai_notice": {
          "$ref": "common.json#/$defs/LangText"
        },
        "human_handoff_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "conformance": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "v0-core",
            "v0-full"
          ]
        },
        "attestation": {
          "$ref": "common.json#/$defs/Jws"
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "status_list"
      ],
      "properties": {
        "status_list": {
          "type": "object",
          "required": [
            "uri",
            "idx"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "format": "uri"
            },
            "idx": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
