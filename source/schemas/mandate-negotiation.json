              "$ref": "common.json#/$defs/Amount"
            },
            "drip_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "agreed_issue_reopened": {
              "const": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "buyer"
              }
            }
          },
          "then": {
            "properties": {
              "price": {
                "required": [
                  "total_max",
                  "reservation"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "seller"
              }
            }
          },
          "then": {
            "properties": {
              "price": {
                "required": [
                  "total_min"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
