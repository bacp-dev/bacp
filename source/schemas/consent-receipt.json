{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bacp.dev/schemas/consent-receipt.json",
  "title": "ConsentReceipt (DPDP)",
  "description": "One receipt per recipient Data Fiduciary (merchant/BPP) per mandate. Issued by the data-blind Mandate Manager acting as (or for) a DPDP Consent Manager.",
  "type": "object",
  "required": [
    "receipt_id",
    "iss",
    "issued_at",
    "principal_ref",
    "mandate_ref",
    "recipient",
    "data_items",
    "purpose",
    "legal_basis",
    "notice",
    "captured_via",
    "withdrawal",
    "grievance",
    "retention",
    "signature"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^cr_[A-Za-z0-9]{12,40}$"
    },
    "iss": {
      "type": "string"
    },
    "cm_registration_no": {
      "type": [
        "string",
        "null"
      ],
      "description": "DPDP Board registration of the Consent Manager (DPDP Rules 2025, Rule 4, from ~13 Nov 2026)"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "principal_ref": {
      "type": "string"
    },
    "mandate_ref": {
      "type": "string"
    },
    "recipient": {
      "type": "object",
      "required": [
        "fiduciary_name",
        "bpp_id"
      ],
      "properties": {
        "fiduciary_name": {
          "type": "string"
        },
        "bpp_id": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "dpo_contact": {
          "type": "string"
        }
      }
    },
    "data_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "field",
          "form"
        ],
        "properties": {
          "field": {
            "enum": [
              "NAME",
              "PHONE",
              "DELIVERY_ADDRESS",
              "EMAIL",
              "AGE_OVER_18",
              "GSTIN"
            ]
          },
          "form": {
            "enum": [
              "plain",
              "masked",
              "selective_disclosure_vc",
              "token"
            ]
          }
        }
      }
    },
    "purpose": {
      "type": "object",
      "required": [
        "code",
        "text"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "text": {
          "$ref": "common.json#/$defs/LangText"
        },
        "goods_or_services": {
          "type": "string"
        }
      }
    },
    "legal_basis": {
      "enum": [
        "consent_s6",
        "legitimate_use_s7a"
      ]
    },
    "notice": {
      "type": "object",
      "required": [
        "language",
        "hash"
      ],
      "properties": {
        "language": {
          "type": "string",
          "description": "English or an Eighth Schedule language (BCP 47)"
        },
        "hash": {
          "$ref": "common.json#/$defs/Hash"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "translation_model": {
          "type": "string"
        }
      }
    },
    "captured_via": {
      "type": "object",
      "required": [
        "surface",
        "user_action",
        "device_signature"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "description": "Trusted Surface id (PSP app or Mandate Manager app), never the agent"
        },
        "user_action": {
          "enum": [
            "tap_confirm",
            "upi_pin",
            "biometric",
            "passkey",
            "voice_confirm_plus_device"
          ]
        },
        "device_signature": {
          "$ref": "common.json#/$defs/Jws"
        },
        "voice_evidence": {
          "type": "object",
          "properties": {
            "audio_hash": {
              "$ref": "common.json#/$defs/Hash"
            },
            "transcript_hash": {
              "$ref": "common.json#/$defs/Hash"
            },
            "translation_model": {
              "type": "string"
            }
          }
        }
      }
    },
    "withdrawal": {
      "type": "object",
      "required": [
        "uri"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "erasure_signal": {
          "const": true
        }
      }
    },
    "grievance": {
      "type": "object",
      "required": [
        "contact"
      ],
      "properties": {
        "contact": {
          "type": "string"
        },
        "board_complaint_uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "retention": {
      "type": "object",
      "required": [
        "recipient_max"
      ],
      "properties": {
        "recipient_max": {
          "type": "string",
          "description": "ISO 8601 duration"
        },
        "legal_minimum": {
          "type": "string",
          "default": "P1Y",
          "description": "DPDP Rule 8(3)"
        }
      }
    },
    "status": {
      "readOnly": true,
      "enum": [
        "ACTIVE",
        "WITHDRAWN",
        "EXPIRED"
      ]
    },
    "signature": {
      "$ref": "common.json#/$defs/Signature"
    }
  }
}
