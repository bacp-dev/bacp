{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bacp.dev/schemas/loan-offer.json",
  "title": "Credit-at-checkout offer list (KFS) - L7-compliance C-9",
  "description": "PAY-125 KFS fields, PAY-126 unbiased multi-lender display (every matched offer, unmatched lenders named, pre-disclosed ranking metric), PAY-128 cooling-off, PAY-129 repayment payee is the lender. RBI Digital Lending Directions 2025 paras 6(iii), 6(iv), 8(i), 9(ii)-(iii), 10.",
  "type": "object",
  "required": [
    "offers",
    "unmatched_lenders",
    "ranking_metric",
    "requested_amount"
  ],
  "additionalProperties": false,
  "properties": {
    "requested_amount": {
      "$ref": "common.json#/$defs/Amount"
    },
    "ranking_metric": {
      "type": "string",
      "format": "uri",
      "description": "Pre-disclosed, neutral ranking rule (APR ascending)."
    },
    "offers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LoanOffer"
      }
    },
    "unmatched_lenders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lender",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "lender": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "LoanOffer": {
      "type": "object",
      "required": [
        "offer_id",
        "lender",
        "lender_regulated_entity",
        "loan_amount",
        "tenor_months",
        "apr_pct",
        "emi_amount",
        "interest_amount",
        "penal_charges",
        "kfs_ref",
        "cooling_off_days",
        "repayment",
        "no_cost",
        "preselected",
        "rank"
      ],
      "additionalProperties": false,
      "properties": {
        "offer_id": {
          "type": "string"
        },
        "lender": {
          "type": "string"
        },
        "lender_regulated_entity": {
          "type": "string",
          "description": "RBI RE registration of the lender"
        },
        "loan_amount": {
          "$ref": "common.json#/$defs/Amount"
        },
        "tenor_months": {
          "type": "integer",
          "minimum": 1
        },
        "apr_pct": {
          "type": "number",
          "minimum": 0
        },
        "emi_amount": {
          "$ref": "common.json#/$defs/Amount"
        },
        "interest_amount": {
          "$ref": "common.json#/$defs/Amount"
        },
        "processing_fee": {
          "$ref": "common.json#/$defs/Amount"
        },
        "penal_charges": {
          "type": "string"
        },
        "kfs_ref": {
          "type": "string",
          "format": "uri"
        },
        "cooling_off_days": {
          "type": "integer",
          "minimum": 1
        },
        "repayment": {
          "type": "object",
          "required": [
            "payee",
            "mandate_type"
          ],
          "additionalProperties": false,
          "properties": {
            "payee": {
              "type": "string",
              "description": "Always the lender (no pooling, DL 9(ii)-(iii))"
            },
            "mandate_type": {
              "enum": [
                "in.nach.debit",
                "in.upi.autopay",
                "manual"
              ]
            }
          }
        },
        "no_cost": {
          "type": "boolean"
        },
        "preselected": {
          "const": false
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
