{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bacp.dev/schemas/offer.json",
  "title": "Negotiation messages (Offer, CounterOffer, Accept, Reject, Withdraw, Terminate, RequestExtension, AcceptRevoke, BidCommit, BidReveal, BidRetract)",
  "description": "Structured, signed and expiring negotiation messages. Only these are binding. Discriminated by type.",
  "oneOf": [
    {
      "$ref": "#/$defs/Offer"
    },
    {
      "$ref": "#/$defs/Accept"
    },
    {
      "$ref": "#/$defs/Reject"
    },
    {
      "$ref": "#/$defs/Withdraw"
    },
    {
      "$ref": "#/$defs/Terminate"
    },
    {
      "$ref": "#/$defs/RequestExtension"
    },
    {
      "$ref": "#/$defs/AcceptRevoke"
    },
    {
      "$ref": "#/$defs/BidCommit"
    },
    {
      "$ref": "#/$defs/BidReveal"
    },
    {
      "$ref": "#/$defs/BidRetract"
    }
  ],
  "$defs": {
    "Offer": {
      "type": "object",
      "description": "Offer, counter-offer or auction bid. A counter-offer is a rejection of the prior offer plus a new offer (ICA s.7).",
      "properties": {
        "type": {
          "enum": [
            "offer",
            "counter_offer",
            "bid"
          ]
        },
        "msg_id": {
          "type": "string",
          "pattern": "^nmsg_[A-Za-z0-9]{8,40}$"
        },
        "negotiation_id": {
          "type": "string",
          "pattern": "^neg_[A-Za-z0-9]{8,40}$"
        },
        "transaction_id": {
          "type": "string",
          "description": "Beckn context.transaction_id."
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "dispatched_at": {
          "type": "string",
          "format": "date-time",
          "description": "ICA s.4 dispatch time = the created parameter of the sending NP's RFC 9421 signature, confirmed against the receiver CounterSignature within 5 s skew (section 12.5)."
        },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "description": "ICA s.4 receipt time = timestamp inside the receiver's CounterSignature. Filled by the receiver."
        },
        "from": {
          "type": "object",
          "properties": {
            "role": {
              "enum": [
                "buyer",
                "seller",
                "auctioneer"
              ]
            },
            "np_id": {
              "type": "string"
            },
            "agent_id": {
              "type": "string"
            },
            "offeror_kind": {
              "enum": [
                "agent",
                "human"
              ]
            }
          },
          "required": [
            "role",
            "np_id",
            "offeror_kind"
          ],
          "additionalProperties": false
        },
        "to": {
          "type": "object",
          "properties": {
            "role": {
              "enum": [
                "buyer",
                "seller",
                "auctioneer",
                "bidders"
              ]
            },
            "np_id": {
              "type": "string"
            }
          },
          "required": [
            "role"
          ],
          "additionalProperties": false
        },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.json#/$defs/Signature"
          },
          "description": "Detached JWS over JCS(message minus signatures, counter_signature). NP registry key always; agent cnf key too when an agent acted."
        },
        "counter_signature": {
          "$ref": "common.json#/$defs/Jws",
          "description": "Receiver's signed receipt over (request-digest, message-id), Beckn 2.0 CounterSignature. Proves communication (ICA s.4)."
        },
        "advisory": {
          "type": "object",
          "properties": {
            "binding": {
              "const": false
            },
            "text_hash": {
              "$ref": "common.json#/$defs/Hash"
            },
            "chat_ref": {
              "type": "string"
            }
          },
          "required": [
            "binding"
          ],
          "description": "Free text is advisory, logged, never binding.",
          "additionalProperties": false
        },
        "in_reply_to": {
          "$ref": "common.json#/$defs/Hash",
          "description": "offer_hash of the live offer this counters. Required for counter_offer."
        },
        "mode": {
          "$ref": "negotiation-session.json#/$defs/Mode"
        },
        "firm": {
          "type": "boolean",
          "description": "true = binding if accepted before expires_at. false = indicative quote, an invitation to treat."
        },
        "subject_to_principal_approval": {
          "type": "boolean",
          "description": "Required true when the emitting agent's guard returned escalate. Forces firm=false."
        },
        "term_sheet": {
          "$ref": "termsheet.json"
        },
        "all_in_total": {
          "$ref": "common.json#/$defs/Amount",
          "description": "MUST equal term_sheet.all_in_total."
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Absolute expiry (not a relative ttl). expires_at - valid_from >= min_offer_validity."
        },
        "inventory_hold_until": {
          "type": "string",
          "format": "date-time"
        },
        "acceptance_manner": {
          "const": "bacp.neg.accept",
          "description": "ICA s.7(2): the offer prescribes the manner of acceptance. Any other form (chat, voice, payment, on_init without accept) is non-conforming and MUST be rejected promptly with NEG_ACCEPT_NONCONFORMING."
        },
        "acceptance_revocation": {
          "enum": [
            "waived",
            "allowed_until_receipt"
          ],
          "default": "waived",
          "description": "ICA s.5 lets an acceptor revoke until the acceptance reaches the proposer. waived = expressly excluded by protocol terms (default). allowed_until_receipt = accept_revoke is honoured if received before the ACCEPT."
        },
        "extends": {
          "$ref": "common.json#/$defs/Hash",
          "description": "offer_hash of an earlier offer by the same offeror that this one re-issues with a later expires_at (answer to request_extension). Terms MUST be identical."
        },
        "rfq_parent_id": {
          "type": "string",
          "pattern": "^rfq_[A-Za-z0-9]{8,40}$",
          "description": "Parent RFQ for exposure counting across sessions."
        },
        "bid_deposit_ref": {
          "type": "string",
          "description": "Deposit or EMD reference required for sealed bids. Forfeited if the bid is not revealed."
        },
        "agreed_issues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "JSON Pointers of issues in Agree. Narrows, does not bind."
        },
        "auction_id": {
          "type": "string",
          "pattern": "^auc_[A-Za-z0-9]{8,40}$"
        },
        "jurisdictional": {
          "type": "object",
          "properties": {
            "mrp_checked": {
              "type": "boolean"
            },
            "msme_seller": {
              "type": "boolean"
            },
            "msmed_due_days_cap": {
              "type": "integer"
            },
            "cash_limit_checked": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "msg_id",
        "negotiation_id",
        "transaction_id",
        "round",
        "dispatched_at",
        "from",
        "signatures",
        "mode",
        "firm",
        "term_sheet",
        "all_in_total",
        "valid_from",
        "expires_at",
        "acceptance_manner"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "counter_offer"
              }
            }
          },
          "then": {
            "required": [
              "in_reply_to"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "subject_to_principal_approval": {
                "const": true
              }
            },
            "required": [
              "subject_to_principal_approval"
            ]
          },
          "then": {
            "properties": {
              "firm": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bid"
              }
            }
          },
          "then": {
            "required": [
              "auction_id"
            ]
          }
        }
      ]
    },
    "Accept": {
      "type": "object",
      "description": "Absolute, unqualified acceptance of exactly one live offer. Carries no terms.",
      "properties": {
        "type": {
          "const": "accept"
        },
        "msg_id": {
          "type": "string",
          "pattern": "^nmsg_[A-Za-z0-9]{8,40}$"
        },
        "negotiation_id": {
          "type": "string",
          "pattern": "^neg_[A-Za-z0-9]{8,40}$"
        },
        "transaction_id": {
          "type": "string",
          "description": "Beckn context.transaction_id."
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "dispatched_at": {
          "type": "string",
          "format": "date-time",
          "description": "ICA s.4 dispatch time = the created parameter of the sending NP's RFC 9421 signature, confirmed against the receiver CounterSignature within 5 s skew (section 12.5)."
        },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "description": "ICA s.4 receipt time = timestamp inside the receiver's CounterSignature. Filled by the receiver."
        },
        "from": {
          "type": "object",
          "properties": {
            "role": {
              "enum": [
                "buyer",
                "seller",
                "auctioneer"
              ]
            },
            "np_id": {
              "type": "string"
            },
            "agent_id": {
              "type": "string"
            },
            "offeror_kind": {
              "enum": [
                "agent",
                "human"
              ]
            }
          },
          "required": [
            "role",
            "np_id",
            "offeror_kind"
          ],
          "additionalProperties": false
        },
        "to": {
          "type": "object",
          "properties": {
            "role": {
              "enum": [
                "buyer",
                "seller",
                "auctioneer",
                "bidders"
              ]
            },
            "np_id": {
              "type": "string"
            }
          },
          "required": [
            "role"
          ],
          "additionalProperties": false
        },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.json#/$defs/Signature"
          },
          "description": "Detached JWS over JCS(message minus signatures, counter_signature). NP registry key always; agent cnf key too when an agent acted."
        },
        "counter_signature": {
          "$ref": "common.json#/$defs/Jws",
          "description": "Receiver's signed receipt over (request-digest, message-id), Beckn 2.0 CounterSignature. Proves communication (ICA s.4)."
        },
        "advisory": {
          "type": "object",
          "properties": {
            "binding": {
              "const": false
            },
            "text_hash": {
              "$ref": "common.json#/$defs/Hash"
            },
            "chat_ref": {
              "type": "string"
            }
          },
          "required": [
            "binding"
          ],
          "description": "Free text is advisory, logged, never binding.",
          "additionalProperties": false
        },
        "offer_hash": {
          "$ref": "common.json#/$defs/Hash",
          "description": "sha-256 over JCS(offer minus signatures, counter_signature). Acceptance must mirror it exactly (ICA s.7)."
        },
        "negotiation_mandate_ref": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "hash": {
              "$ref": "common.json#/$defs/Hash"
            }
          },
          "required": [
            "id",
            "hash"
          ],
          "description": "The separate BACP negotiation mandate. Its contents are never disclosed to the counterparty.",
          "additionalProperties": false
        },
        "legal_effect": {
          "enum": [
            "acceptance",
            "purchase_offer"
          ],
          "description": "acceptance when the accepted offer was firm. purchase_offer when it was non-firm (an invitation to treat): the ACCEPT is then legally an offer and the seller's on_init/on_confirm is the acceptance."
        },
        "bound_attestation": {
          "$ref": "#/$defs/BoundAttestation"
        },
        "step_up_id": {
          "type": "string",
          "description": "Present when the principal approved an out-of-mandate deal on the Trusted Surface."
        }
      },
      "required": [
        "type",
        "msg_id",
        "negotiation_id",
        "transaction_id",
        "round",
        "dispatched_at",
        "from",
        "signatures",
        "offer_hash",
        "negotiation_mandate_ref",
        "legal_effect",
        "bound_attestation"
      ],
      "additionalProperties": false,
      "not": {
        "anyOf": [
          {
            "required": [
              "term_sheet"
            ]
          },
          {
            "required": [
              "in_reply_to"
            ]
          }
        ]
      }
    },
    "Reject": {
      "type": "object",
      "description": "Rejection of the live offer.",
      "properties": {
        "type": {
          "const": "reject"
        },
        "msg_id": {
          "type": "string",
          "pattern": "^nmsg_[A-Za-z0-9]{8,40}$"
        },
