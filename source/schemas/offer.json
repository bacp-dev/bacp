                "seller",
                "auctioneer"
              ]
            },
            "np_id": {
              "type": "string"
            },
            "agent_id": {
              "type": "string"
            },
            "offeror_kind": {
              "enum": [
                "agent",
                "human"
              ]
            }
          },
          "required": [
            "role",
            "np_id",
            "offeror_kind"
          ],
          "additionalProperties": false
        },
        "to": {
          "type": "object",
          "properties": {
            "role": {
              "enum": [
                "buyer",
                "seller",
                "auctioneer",
                "bidders"
              ]
            },
            "np_id": {
              "type": "string"
            }
          },
          "required": [
            "role"
          ],
          "additionalProperties": false
        },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.json#/$defs/Signature"
          },
          "description": "Detached JWS over JCS(message minus signatures, counter_signature). NP registry key always; agent cnf key too when an agent acted."
        },
        "counter_signature": {
          "$ref": "common.json#/$defs/Jws",
          "description": "Receiver's signed receipt over (request-digest, message-id), Beckn 2.0 CounterSignature. Proves communication (ICA s.4)."
        },
        "advisory": {
          "type": "object",
          "properties": {
            "binding": {
              "const": false
            },
            "text_hash": {
              "$ref": "common.json#/$defs/Hash"
            },
            "chat_ref": {
              "type": "string"
            }
          },
          "required": [
            "binding"
          ],
          "description": "Free text is advisory, logged, never binding.",
          "additionalProperties": false
        },
        "offer_hash": {
          "$ref": "common.json#/$defs/Hash"
        },
        "reason_code": {
          "enum": [
            "price",
            "delivery",
            "payment_terms",
            "quality",
            "not_negotiable",
            "mrp_exceeded",
            "msmed_credit_cap",
            "terms_drift",
            "out_of_mandate",
            "incoterm_not_supported",
            "other"
          ],
          "description": "Typed reasons. Never carries the reservation value."
        },
        "ondc_error_code": {
          "type": "string",
          "description": "e.g. 50005 Incoterm not supported."
        },
        "final": {
          "type": "boolean",
          "description": "true ends the negotiation (REJECTED). false leaves room for a new offer."
        }
      },
      "required": [
        "type",
        "msg_id",
        "negotiation_id",
        "transaction_id",
        "round",
        "dispatched_at",
        "from",
        "signatures",
        "offer_hash",
        "reason_code",
        "final"
      ],
      "additionalProperties": false
    },
    "Withdraw": {
      "type": "object",
      "description": "Revocation by the offeror before acceptance is complete as against it (ICA s.5).",
