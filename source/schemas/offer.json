        },
        "reason": {
          "enum": [
            "offeror_choice",
            "mandate_revoked",
            "stock_change",
            "price_error",
            "other"
          ]
        }
      },
      "required": [
        "type",
        "msg_id",
        "negotiation_id",
        "transaction_id",
        "round",
        "dispatched_at",
        "from",
        "signatures",
        "offer_hash",
