{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bacp.dev/schemas/negotiation-session.json",
  "title": "NegotiationSession",
  "description": "Authoritative full-state view of one bilateral negotiation (one buyer, one seller, one transaction_id), as returned by the gateway (ACP full-state pattern). RFQs and auctions own several sessions.",
  "type": "object",
  "required": [
    "negotiation_id",
    "transaction_id",
    "mode",
    "role",
    "state",
    "counterparty",
    "capability",
    "mandate_ref",
    "presence",
    "round",
    "negotiation_deadline",
    "transcript",
    "messages",
    "created_at",
    "protocol_terms"
  ],
  "properties": {
    "negotiation_id": {
      "type": "string",
      "pattern": "^neg_[A-Za-z0-9]{8,40}$"
    },
    "transaction_id": {
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "role": {
      "enum": [
        "buyer",
        "seller"
      ]
    },
    "profile": {
      "type": "string",
      "readOnly": true,
      "description": "The one trade profile the session declares (for example b2c.ecom or b2b.procurement), fixed when the session opens. The buyer side declares it in a buyer-signed message and the buyer gateway fills it from the mandate; a profile a model supplies that differs is refused with 403 mandate_scope_mismatch. Either party MAY refuse a profile with capabilities_incompatible (reason profile_not_supported or profile_misdescribed). A seller never reclassifies it."
    },
    "acting_for_kind": {
      "enum": [
        "individual",
        "business"
      ],
      "readOnly": true,
      "description": "Whom the buyer side acts for, declared at session open and pinned. A consumer marker always wins: a GSTIN does not end consumer status (Consumer Protection Act, 2019 s.2(7), Explanation (a))."
    },
    "state": {
      "enum": [
        "OPEN",
        "AWAITING_OFFER",
        "NEGOTIATING",
        "ESCALATED",
        "ACCEPT_PENDING",
        "AGREED",
        "PURCHASE_OFFERED",
        "BOUND",
        "BREACH_FLAGGED",
        "CONTRACTED",
        "CANCELLED",
        "REJECTED",
        "TERMINATED"
      ]
    },
    "counterparty": {
      "type": "object",
      "properties": {
        "bpp_id": {
          "type": "string"
        },
        "bap_id": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "offeror_kind": {
          "enum": [
            "agent",
            "human"
          ]
        },
        "udyam_category": {
          "$ref": "common.json#/$defs/UdyamCategory"
        },
        "pricing_ai_vendor": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "properties": {
        "negotiable_issues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "JSON Pointers into TermSheet, e.g. /lines/*/unit_price, /payment/credit_days"
        },
        "modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mode"
          },
          "minItems": 1
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "round_timeout": {
          "$ref": "common.json#/$defs/Duration"
        },
        "min_offer_validity": {
          "$ref": "common.json#/$defs/Duration"
        },
        "sig_algs": {
          "type": "array",
          "items": {
            "enum": [
              "ES256",
              "EdDSA"
            ]
          }
        },
        "firm_quote_supported": {
          "type": "boolean"
        },
        "accepted_handlers": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/HandlerRef"
          }
        },
        "pricing_ai_vendor": {
          "type": "string"
        }
      },
      "required": [
        "negotiable_issues",
        "modes",
        "max_rounds",
        "min_offer_validity",
        "sig_algs"
      ],
      "description": "bacp.negotiation capability advert and the session intersection.",
      "additionalProperties": false
    },
    "mandate_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "hash": {
          "$ref": "common.json#/$defs/Hash"
        }
      },
      "required": [
        "id",
        "hash"
      ],
      "description": "The separate BACP negotiation mandate.",
      "additionalProperties": false
    },
    "checkout_mandate_ref": {
      "type": "string",
      "description": "Linked AP2-compatible open checkout mandate."
    },
    "presence": {
      "$ref": "common.json#/$defs/Presence"
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "max_rounds": {
      "type": "integer",
      "minimum": 1
    },
    "negotiation_deadline": {
      "type": "string",
      "format": "date-time"
    },
    "offers": {
      "type": "array",
      "description": "Offer state is tracked per offer, separately from the negotiation state.",
      "items": {
        "type": "object",
        "properties": {
          "offer_hash": {
            "$ref": "common.json#/$defs/Hash"
          },
          "by": {
            "enum": [
              "buyer",
              "seller",
              "auctioneer"
            ]
          },
          "round": {
            "type": "integer"
          },
          "firm": {
            "type": "boolean"
          },
          "state": {
            "enum": [
              "LIVE",
              "SUPERSEDED",
              "ACCEPTED",
              "ACCEPT_REVOKED",
              "REJECTED",
              "WITHDRAWN",
              "EXPIRED",
              "LAPSED_CONDITION"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "dispatched_at": {
            "type": "string",
            "format": "date-time"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "extends": {
            "$ref": "common.json#/$defs/Hash"
          }
        },
        "required": [
          "offer_hash",
          "by",
          "firm",
          "state",
          "expires_at"
        ],
        "additionalProperties": false
      }
    },
    "exposure": {
      "type": "object",
      "properties": {
        "principal_outstanding_firm": {
          "$ref": "common.json#/$defs/Amount"
        },
        "counted_against": {
          "type": "array",
          "items": {
            "enum": [
              "total_max",
              "budget_P1D",
              "budget_P7D",
              "budget_P1M",
              "budget_LIFETIME"
            ]
          }
        },
        "concurrent_negotiations": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "principal_outstanding_firm",
        "counted_against"
      ],
      "description": "Outstanding firm counters and accepts across all of the principal's concurrent negotiations. Amounts only, never the bound.",
      "additionalProperties": false
    },
    "live_offer": {
      "type": "object",
      "properties": {
        "offer_hash": {
          "$ref": "common.json#/$defs/Hash"
        },
        "by": {
          "enum": [
            "buyer",
            "seller",
            "auctioneer"
          ]
        },
        "firm": {
          "type": "boolean"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "all_in_total": {
          "$ref": "common.json#/$defs/Amount"
        },
        "term_sheet": {
          "$ref": "termsheet.json"
        },
        "guard": {
          "enum": [
            "acceptable",
            "not_acceptable",
            "needs_escalation",
            "not_evaluated"
          ],
          "description": "Only the verdict reaches the agent LLM."
        }
      },
      "required": [
        "offer_hash",
        "by",
        "firm",
        "expires_at",
        "all_in_total"
      ],
      "additionalProperties": false
    },
    "transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "msg_type": {
            "type": "string"
          },
          "msg_hash": {
            "$ref": "common.json#/$defs/Hash"
          },
          "by": {
            "enum": [
              "buyer",
              "seller",
              "auctioneer",
              "gateway",
              "trusted_surface"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "counter_signature": {
            "$ref": "common.json#/$defs/Jws",
            "description": "BACP CounterSignature: a compact JWS by the receiving participant's registry key whose payload is a CounterSignaturePayload (msg_hash, negotiation_id, received_at, log_seq, log_entry_hash, prev_entry_hash). Proves communication (ICA s.4). Settled in Q-43."
          },
          "log_entry_hash": {
            "$ref": "common.json#/$defs/Hash"
          },
          "clock_step_observed": {
            "type": "boolean",
            "description": "True when received_at on this entry is earlier than on an entry before it in the chain because the participant's clock stepped. REQUIRED when received_at decreases along the chain; an unflagged decrease is evidence_unverifiable. Order is by log position only."
          },
          "late_receipt_party": {
            "enum": [
              "offeror",
              "offeree"
            ],
            "description": "On the record of a contested crossing: the party whose receipt (or logging) of the other's message came after its own dispatch, so that a reviewer sees who held the later position."
          }
        },
        "required": [
          "seq",
          "msg_type",
          "msg_hash",
          "by",
          "at"
        ],
        "additionalProperties": false
      },
      "description": "Hash-chained via the InstructionLog stage negotiation."
    },
    "guard_verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "msg_hash": {
            "$ref": "common.json#/$defs/Hash"
          },
          "direction": {
            "enum": [
              "outgoing",
              "incoming"
            ]
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "escalate"
            ]
          },
          "constraint_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "IDs only, never values."
          }
        },
        "required": [
          "at",
          "msg_hash",
          "direction",
          "verdict",
          "constraint_ids"
        ],
        "additionalProperties": false
      }
    },
    "validator_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "NEG_MRP_EXCEEDED",
              "NEG_MSMED_CREDIT_CAP",
              "NEG_DRIP_PRICING",
              "NEG_TERMS_DRIFT",
              "NEG_FALSE_URGENCY",
              "NEG_BASKET_SNEAK",
              "NEG_PERSONALISED_PRICING",
              "NEG_STALE_OFFER",
              "NEG_ISSUE_NOT_NEGOTIABLE",
              "NEG_OFFER_EXPIRED",
              "NEG_CASH_LIMIT",
              "NEG_RERA_TOKEN_CAP",
              "NEG_SHILL_BID",
              "NEG_EARLY_AWARD",
              "NEG_EARLY_REVEAL",
              "NEG_DUTCH_PRICE_INCREASE",
              "NEG_COLLUSION_SCREEN",
              "NEG_INJECTION_SUSPECTED",
              "NEG_CREDIT_DISCLOSURE_MISSING",
              "NEG_EMI_NO_COST_FALSE",
              "NEG_EINVOICE_IRN_MISSING",
              "NEG_EWB_MISSING"
            ]
          },
          "severity": {
            "enum": [
              "block",
              "step_up",
              "warn"
            ]
          },
          "issue_path": {
            "type": "string"
          },
          "msg_hash": {
            "$ref": "common.json#/$defs/Hash"
          }
        },
        "required": [
          "code",
          "severity"
        ],
        "additionalProperties": false
      }
    },
    "step_up": {
      "type": "object",
      "description": "StepUp object (OpenAPI components.schemas.StepUp) with reason negotiation_out_of_mandate and a diff card.",
      "properties": {
        "step_up_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "confirm",
            "rail_auth"
          ]
        },
        "reason": {
          "type": "string"
        },
        "trusted_surface_url": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "diff": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "issue_path": {
                "type": "string"
              },
              "offered": {},
              "within_bounds": {
                "type": "boolean"
              }
            },
            "required": [
              "issue_path",
              "within_bounds"
            ],
            "description": "Shown to the principal only, on the Trusted Surface. The bound itself is rendered there, never sent to the agent or counterparty.",
            "additionalProperties": false
          }
        }
      },
      "required": [
        "step_up_id",
        "kind",
        "reason",
        "trusted_surface_url",
        "expires_at"
      ]
    },
    "accepted_offer_hash": {
      "$ref": "common.json#/$defs/Hash"
    },
    "bound_term_sheet_hash": {
      "$ref": "common.json#/$defs/Hash"
    },
    "session_id": {
      "type": "string",
      "pattern": "^ses_[A-Za-z0-9]{8,40}$",
      "description": "Checkout session opened after BOUND"
    },
    "order_id": {
      "type": "string"
    },
    "rfq_id": {
      "type": "string"
    },
    "auction_id": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/DocumentRef"
      }
    },
    "log_head": {
      "$ref": "common.json#/$defs/Hash"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "code",
          "resolution"
        ],
        "properties": {
          "type": {
            "enum": [
              "error",
              "warning",
              "info",
              "disclosure"
            ]
          },
          "code": {
            "type": "string"
          },
          "content": {
            "$ref": "common.json#/$defs/LangText"
          },
          "param": {
            "type": "string"
          },
          "resolution": {
            "enum": [
              "recoverable",
              "requires_buyer_input",
              "requires_buyer_review",
              "requires_seller_review",
              "unrecoverable"
            ]
          }
        }
      },
      "description": "Message model (OpenAPI components.schemas.Message)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "protocol_terms": {
      "$ref": "offer.json#/$defs/ProtocolTerms",
      "description": "The protocol terms (ordering rule, receipt window, contested outcome, expires_at as a receipt deadline, IT Act s.12(2) acknowledgement) that govern this negotiation, named at session open in a buyer-signed message. A mismatch between the two sides is refused with capabilities_incompatible."
    },
    "counter_signature": {
      "$ref": "common.json#/$defs/Jws",
      "description": "On the response to a message the gateway has just sent: the counterparty's CounterSignature (payload CounterSignaturePayload) for that message, returned in the synchronous response of the exchange. Absent when the counterparty returned none or it did not verify, in which case a crossing that depends on that message is contested."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Mode": {
      "enum": [
        "fixed",
        "posted_dynamic",
        "alternating",
        "rfq_sealed",
        "rfq_iterated",
        "english",
        "reverse_l1",
        "dutch",
        "scheme"
      ]
    },
    "Capability": {
      "type": "object",
      "properties": {
        "negotiable_issues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "JSON Pointers into TermSheet, e.g. /lines/*/unit_price, /payment/credit_days"
        },
        "modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mode"
          },
          "minItems": 1
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "round_timeout": {
          "$ref": "common.json#/$defs/Duration"
        },
        "min_offer_validity": {
          "$ref": "common.json#/$defs/Duration"
        },
        "sig_algs": {
          "type": "array",
          "items": {
            "enum": [
              "ES256",
              "EdDSA"
            ]
          }
        },
        "firm_quote_supported": {
          "type": "boolean"
        },
        "accepted_handlers": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/HandlerRef"
          }
        },
        "pricing_ai_vendor": {
          "type": "string"
        },
        "step_up_cap": {
          "type": "object",
          "description": "Declared by the gateway in /.well-known/bacp. The most negotiation, fee-line and HNP step-ups the gateway creates per principal in a window. Beyond it the gateway answers the agent with 429 and Retry-After and nothing is visible to the counterparty: a capped offer lapses by silence. BACP sets no number.",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "window": {
              "$ref": "common.json#/$defs/Duration"
            }
          },
          "required": [
            "count",
            "window"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "negotiable_issues",
        "modes",
        "max_rounds",
        "min_offer_validity",
        "sig_algs"
      ],
      "description": "bacp.negotiation capability advert and the session intersection.",
      "additionalProperties": false
    },
    "AuctionSpec": {
      "type": "object",
      "properties": {
        "auction_id": {
          "type": "string",
          "pattern": "^auc_[A-Za-z0-9]{8,40}$"
        },
        "type": {
          "enum": [
            "english",
            "reverse_l1",
            "dutch",
            "sealed_first_price"
          ]
        },
        "auctioneer": {
          "$ref": "common.json#/$defs/Party"
        },
        "auctioneer_neutrality": {
          "type": "object",
          "properties": {
            "operator_type": {
              "enum": [
                "network_auction_service",
                "government_platform",
                "exchange",
                "regulated_market"
              ]
            },
            "affiliated_with_any_seller": {
              "const": false
            },
            "clock_source": {
              "type": "string",
              "description": "Authoritative bid clock, e.g. auctioneer CounterSignature timestamps"
            }
          },
          "required": [
            "operator_type",
            "affiliated_with_any_seller",
            "clock_source"
          ],
          "description": "Bid clock run by a neutral auctioneer, never the seller BPP (shill and conflict risk).",
          "additionalProperties": false
        },
        "lots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "lot_id": {
                "type": "string"
              },
              "item_id": {
                "type": "string"
              },
              "quantity": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              },
              "assay": {
                "$ref": "common.json#/$defs/DocumentRef"
              },
              "mrp": {
                "$ref": "common.json#/$defs/Amount"
              }
            },
            "required": [
              "lot_id",
              "quantity"
            ],
            "additionalProperties": false
          }
        },
        "reserve_price": {
          "$ref": "common.json#/$defs/Amount"
        },
        "reserve_disclosed": {
          "type": "boolean"
        },
        "start_price": {
          "$ref": "common.json#/$defs/Amount"
        },
        "increment": {
          "$ref": "common.json#/$defs/Amount"
        },
        "decrement_schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "price": {
                "$ref": "common.json#/$defs/Amount"
              }
            },
            "required": [
              "at",
              "price"
            ],
            "additionalProperties": false
          },
          "description": "Dutch: non-increasing price ticks."
        },
        "opens_at": {
          "type": "string",
          "format": "date-time"
        },
        "closes_at": {
          "type": "string",
          "format": "date-time"
        },
        "extension_rule": {
          "type": "object",
          "properties": {
            "window": {
              "$ref": "common.json#/$defs/Duration"
            },
            "extend_by": {
              "$ref": "common.json#/$defs/Duration"
            },
            "max_extensions": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "window",
            "extend_by",
            "max_extensions"
          ],
          "description": "Normative anti-sniping: a bid received inside window before closes_at extends close by extend_by.",
          "additionalProperties": false
        },
        "visibility": {
          "enum": [
            "sealed",
            "price_only",
            "open"
          ],
          "description": "reverse_l1 shows the current L1 price without bidder identity."
        },
        "tie_break": {
          "enum": [
            "earliest_bid",
            "lottery",
            "msme_preference",
            "make_in_india_preference"
          ],
          "description": "Dutch: always earliest_bid, which means the earliest position in the auctioneer's own hash chain; no clock reading decides a Dutch award. Other types: the stated rule."
        },
        "bid_deposit": {
          "type": "object",
          "properties": {
            "amount": {
              "$ref": "common.json#/$defs/Amount"
            },
            "instrument": {
              "enum": [
                "emd",
                "ebg",
                "upi_otm_block",
                "pa_escrow"
              ]
            },
            "forfeit_on": {
              "type": "array",
              "items": {
                "enum": [
                  "no_reveal",
                  "win_and_walk_away",
                  "retraction_in_window"
                ]
              }
            }
          },
          "required": [
            "amount",
            "instrument",
            "forfeit_on"
          ],
          "description": "Required for sealed (commit-reveal) modes.",
          "additionalProperties": false
        },
        "retraction_rule": {
          "enum": [
            "no_retraction",
            "before_close_outside_window",
            "obvious_error_only"
          ],
          "description": "Sale of Goods Act s.64 lets a bidder retract before the hammer (see open question Q-35). Default before_close_outside_window."
        },
        "eligibility": {
          "type": "object",
          "properties": {
            "bidder_allowlist": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "technical_qualified_only": {
              "type": "boolean"
            },
            "licence_required": {
              "type": "string"
            },
            "exclude_suspended": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "award_rule": {
          "enum": [
            "highest_price",
            "l1",
            "first_accept",
            "qcbs"
          ]
        },
        "fixed_terms": {
          "$ref": "termsheet.json",
          "description": "Non-price issues fixed for all bidders, or scored by scoring_rule."
        },
        "scoring_rule_ref": {
          "type": "string",
          "format": "uri"
        },
        "procurement_mode_reason": {
          "type": "string",
          "description": "Why this mode was chosen, e.g. value threshold."
        },
        "signature": {
          "$ref": "common.json#/$defs/Signature",
          "description": "The neutral auctioneer's signature over the published spec, made before the first bid; rules MUST NOT change after it. Optional in a create request, where any signature is the requester's own and is not relied on. Required in the published spec (PublishedAuctionSpec)."
        },
        "standing_accepts_enabled": {
          "type": "boolean",
          "description": "Optional. true = the auctioneer takes StandingAccept objects before the auction opens and runs them as the Dutch rules describe. Absent or false means the base chain-order rule only."
        }
      },
      "required": [
        "auction_id",
        "type",
        "auctioneer",
        "auctioneer_neutrality",
        "lots",
        "opens_at",
        "closes_at",
        "extension_rule",
        "visibility",
        "tie_break",
        "award_rule",
        "retraction_rule"
      ],
      "description": "Signed before the first bid. Rules MUST NOT change after it.",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "visibility": {
                "const": "sealed"
              }
            }
          },
          "then": {
            "required": [
              "bid_deposit"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "dutch"
              }
            }
          },
          "then": {
            "required": [
              "decrement_schedule"
            ],
            "properties": {
              "tie_break": {
                "const": "earliest_bid"
              }
            }
          }
        }
      ]
    },
    "PublishedAuctionSpec": {
      "description": "An AuctionSpec as published by the neutral auctioneer: signed by the auctioneer, with its spec_hash frozen and authoritative.",
      "allOf": [
        {
          "$ref": "#/$defs/AuctionSpec"
        }
      ],
      "required": [
        "signature"
      ]
    },
    "Rfq": {
      "type": "object",
      "properties": {
        "rfq_id": {
          "type": "string",
          "pattern": "^rfq_[A-Za-z0-9]{8,40}$"
        },
        "mode": {
          "enum": [
            "rfq_sealed",
            "rfq_iterated"
          ]
        },
        "term_sheet_draft": {
          "$ref": "termsheet.json"
        },
        "issues_negotiable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invitees": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bpp_id": {
                "type": "string"
              },
              "provider_id": {
                "type": "string"
              }
            },
            "required": [
              "bpp_id"
            ],
            "additionalProperties": false
          }
        },
        "broadcast": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string"
            },
            "city": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "response_by": {
          "type": "string",
          "format": "date-time",
          "description": "Award before this time is rejected unless all invitees responded."
        },
        "min_responses": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum number of valid quotations before award, e.g. 3 for an L1 purchase. Required: a request without it is refused with 400 invalid_request."
        },
        "award_rule": {
          "enum": [
            "l1_landed_cost",
            "qcbs",
            "best_score"
          ]
        },
        "scoring_rule_ref": {
          "type": "string",
          "format": "uri"
        },
        "state": {
          "enum": [
            "DRAFT",
            "PUBLISHED",
            "COLLECTING",
            "CLOSED",
            "REVEALED",
            "SHORTLISTED",
            "AWARDED",
            "CANCELLED"
          ],
          "readOnly": true
        },
        "negotiation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "readOnly": true
        },
        "comparison": {
          "type": "array",
          "readOnly": true,
          "items": {
            "type": "object",
            "properties": {
              "negotiation_id": {
                "type": "string"
              },
              "offer_hash": {
                "$ref": "common.json#/$defs/Hash"
              },
              "landed_cost": {
                "$ref": "common.json#/$defs/Amount"
              },
              "rank": {
                "type": "integer"
              }
            },
            "required": [
              "negotiation_id",
              "landed_cost"
            ],
            "additionalProperties": false
          },
          "description": "Normalised to landed cost. Kept for audit."
        },
        "awarded": {
          "type": "object",
          "properties": {
            "negotiation_id": {
              "type": "string"
            },
            "offer_hash": {
              "$ref": "common.json#/$defs/Hash"
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "readOnly": true
        },
        "acceptance_revocation_required": {
          "const": "waived",
          "description": "Optional. Business sessions only. The buyer's own RFQ requires that quotations carry acceptance_revocation waived. The seller's gateway fills waiver_basis with doc_type rfq and the hash of the published RFQ. Refused in a consumer session. An RFQ created by an agent that sets it needs a confirm step-up with reason rfq_prescribes_waiver, because it waives the principal's own ICA s.5 right."
        }
      },
      "required": [
        "rfq_id",
        "mode",
        "term_sheet_draft",
        "response_by",
        "min_responses",
        "award_rule"
      ],
      "description": "Structured RFQ replacing ONDC BUYER_TERMS free text.",
      "additionalProperties": false
    },
    "AuctionState": {
      "type": "object",
      "properties": {
        "auction_id": {
          "type": "string"
        },
        "spec_hash": {
          "$ref": "common.json#/$defs/Hash"
        },
        "state": {
          "enum": [
            "SCHEDULED",
            "OPEN",
            "EXTENDED",
            "CLOSED",
            "REVEALED",
            "AWARDED",
            "NO_AWARD",
            "CANCELLED"
          ]
        },
        "current_price": {
          "$ref": "common.json#/$defs/Amount"
        },
        "current_rank_for_caller": {
          "type": "integer",
          "minimum": 1
        },
        "bids_count": {
          "type": "integer",
          "minimum": 0
        },
        "closes_at": {
          "type": "string",
          "format": "date-time"
        },
        "awarded_offer_hash": {
          "$ref": "common.json#/$defs/Hash"
        },
        "caller_negotiation_id": {
          "type": "string"
        },
        "tick_close": {
          "type": "object",
          "description": "Dutch only. The auctioneer's signed close of one tick, published to every bidder at that tick: the countersigned acceptances in chain order and the chain head. An acceptance belongs to tick k when its receipt position precedes this entry. A bidder whose countersigned position is missing from accepts, or appears at another position, holds a signed contradiction (evidence_unverifiable, NEG_COLLUSION_SCREEN or a NEG_AWARD_RULE dispute).",
          "properties": {
            "tick": {
              "type": "integer",
              "minimum": 0,
              "description": "Index of the tick in decrement_schedule."
            },
            "accepts": {
              "type": "array",
              "description": "Every acceptance countersigned at this tick, in the auctioneer's chain order. log_seq values MUST be unique, which a validator checks because JSON Schema cannot.",
              "items": {
                "type": "object",
                "properties": {
                  "log_seq": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "msg_hash": {
                    "$ref": "common.json#/$defs/Hash"
                  }
                },
                "required": [
                  "log_seq",
                  "msg_hash"
                ],
                "additionalProperties": false
              }
            },
            "log_head": {
              "$ref": "common.json#/$defs/Hash",
              "description": "The auctioneer's chain head at the time of the close."
            },
            "signature": {
              "$ref": "common.json#/$defs/Signature",
              "description": "The auctioneer's signature over the JCS form of the object without signature."
            }
          },
          "required": [
            "tick",
            "accepts",
            "log_head",
            "signature"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "auction_id",
        "spec_hash",
        "state",
        "closes_at"
      ],
      "description": "Bidder view. Never shows other bidders' identities or sealed bids.",
      "additionalProperties": false
    },
    "StandingAccept": {
      "type": "object",
      "description": "A principal-signed standing acceptance lodged with the auctioneer before a Dutch auction opens, so that a bidder who cannot react in seconds (an IVR or feature-phone principal, for example) competes on price and not on reflexes. It is bound to one auction and one lot, expires, and is used at most once. It is lodged through the principal's gateway as a firm bid under the bacp-negotiate tag, so the guard evaluates it at max_price times qty and holds that exposure until the auction closes or the accept is used or withdrawn. At the first tick whose price is at or below max_price the auctioneer runs standing accepts ahead of live accepts at that tick, in the chain order in which they were placed. Allowed only where the AuctionSpec sets standing_accepts_enabled. An auctioneer refuses one whose auction_id or lot_hash is not this auction's, or whose valid_until has passed, with NEG_AWARD_RULE. The principal's gateway refuses with NEG_AWARD_RULE, and records no AGREED for, an award that cites a standing accept it did not lodge for that auction and lot, that has expired, or that was already used or released.",
      "properties": {
        "standing_accept_id": {
          "type": "string",
          "pattern": "^sa_[A-Za-z0-9]{8,40}$",
          "description": "Identifies this standing accept. An auctioneer uses each standing_accept_id at most once."
        },
        "auction_id": {
          "type": "string",
          "pattern": "^auc_[A-Za-z0-9]{8,40}$",
          "description": "The auction this standing accept is for. A standing accept run in any other auction is refused with NEG_AWARD_RULE."
        },
        "lot_hash": {
          "$ref": "common.json#/$defs/Hash",
          "description": "sha-256 of the JCS form of the AuctionSpec lots[] entry this standing accept is for."
        },
        "valid_until": {
          "type": "string",
          "format": "date-time",
          "description": "The last instant at which the auctioneer may run this standing accept. It MUST NOT be later than the auction's closes_at."
        },
        "max_price": {
          "$ref": "common.json#/$defs/Amount",
          "description": "The highest tick price at which the principal accepts."
        },
        "qty": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "The quantity the principal accepts, in the lot's unit."
        },
        "mandate_ref": {
          "type": "string",
          "pattern": "^mdt_[A-Za-z0-9]{12,40}$",
          "description": "The negotiation mandate under which the principal signed the standing accept."
        },
        "sender_log_seq": {
          "$ref": "offer.json#/$defs/Offer/properties/sender_log_seq"
        },
        "sender_log_prev": {
          "$ref": "offer.json#/$defs/Offer/properties/sender_log_prev"
        },
        "protocol_terms": {
          "$ref": "offer.json#/$defs/ProtocolTerms"
        },
        "signature": {
          "$ref": "common.json#/$defs/Signature",
          "description": "The principal's signature over the JCS form of the object without signature."
        }
      },
      "required": [
        "standing_accept_id",
        "auction_id",
        "lot_hash",
        "valid_until",
        "max_price",
        "qty",
        "mandate_ref",
        "sender_log_seq",
        "sender_log_prev",
        "protocol_terms",
        "signature"
      ],
      "additionalProperties": false
    }
  }
}
