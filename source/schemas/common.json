{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bacp.dev/schemas/common.json",
  "title": "BACP common types",
  "$defs": {
    "Amount": {
      "type": "object",
      "description": "Integer minor units (paise) per ISO 4217, as in UCP, ACP and AP2.",
      "required": [
        "value",
        "currency"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "const": "INR"
        }
      },
      "additionalProperties": false
    },
    "PositiveAmount": {
      "type": "object",
      "description": "A payable amount: integer minor units (paise), greater than zero. Used for a closed mandate's amount, a payment or refund Receipt's amount and a payment-plan tender's amount. Amount (minimum 0) stays in use for values that may legitimately be zero, such as a zero-priced free-goods line or a remaining budget.",
      "required": [
        "value",
        "currency"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "const": "INR"
        }
      },
      "additionalProperties": false
    },
    "Hash": {
      "type": "string",
      "description": "Multihash-style 'alg:base64url'. sha-256 is mandatory, blake2b-512 allowed for Beckn digests.",
      "pattern": "^(sha-256|blake2b-512):[A-Za-z0-9_-]{43,88}$"
    },
    "Jws": {
      "type": "string",
      "description": "Compact JWS or SD-JWT (with ~ separators). Payload canonicalised with JCS (RFC 8785).",
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]*\\.[A-Za-z0-9_-]+(~[A-Za-z0-9_.~-]*)?$"
    },
    "Jwk": {
      "type": "object",
      "required": [
        "kty"
      ],
      "properties": {
        "kty": {
          "enum": [
            "EC",
            "OKP"
          ]
        },
        "crv": {
          "enum": [
            "P-256",
            "Ed25519"
          ]
        },
        "x": {
          "type": "string"
        },
        "y": {
          "type": "string"
        },
        "kid": {
          "type": "string"
        }
      }
    },
    "Signature": {
      "type": "object",
      "required": [
        "kid",
        "alg",
        "value"
      ],
      "properties": {
        "role": {
          "enum": [
            "principal",
            "mandate_manager",
            "psp",
            "agent",
            "agent_provider",
            "bap",
            "bpp",
            "registry",
            "operator"
          ]
        },
        "kid": {
          "type": "string",
          "description": "Registry-resolvable key id, e.g. 'bap.example.in|ukid-7|ed25519' or a did:web#fragment"
        },
        "alg": {
          "enum": [
            "ES256",
            "EdDSA"
          ]
        },
        "value": {
          "$ref": "#/$defs/Jws"
        }
      },
      "additionalProperties": false
    },
    "Presence": {
      "enum": [
        "HP",
        "HNP"
      ],
      "description": "Human present / human not present (AP2 section 4.2)."
    },
    "LangText": {
      "type": "object",
      "description": "Multilingual map keyed by BCP 47 tag, e.g. {\"hi-IN\": \"...\", \"en-IN\": \"...\"}.",
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z]{4})?(-[A-Z]{2})?$"
      },
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1
    },
    "RailType": {
      "type": "string",
      "pattern": "^(upi\\.circle\\.delegate|upi\\.reservepay\\.block|upi\\.autopay|upi\\.uap\\.[a-z0-9_.]+)$"
    },
    "Channel": {
      "enum": [
        "app",
        "voice",
        "ivr",
        "upi123pay",
        "whatsapp",
        "web",
        "assisted"
      ]
    },
    "Handler": {
      "enum": [
        "upi.circle.delegate",
        "upi.reservepay.block",
        "upi.autopay",
        "upi.lite",
        "upi.123pay",
        "rupay.token",
        "erupi",
        "erupee",
        "bbps",
        "cod",
        "upi.pin"
      ],
      "description": "Legacy BACP payment handler ids. upi.uap.* is reserved and validated by RailType."
    },
    "Duration": {
      "type": "string",
      "description": "ISO 8601 duration, e.g. P30D, PT15M",
      "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$"
    },
    "IssueStatus": {
      "enum": [
        "Assert",
        "Agree",
        "Disagree",
        "Terminate"
      ],
      "description": "Per-issue status generalised from ONDC *_status."
    },
    "IssueMeta": {
      "type": "object",
      "properties": {
        "negotiable": {
          "type": "boolean",
          "default": false,
          "description": "False = fixed issue. A counter that changes a fixed issue is rejected with NEG_ISSUE_NOT_NEGOTIABLE."
        },
        "status": {
          "$ref": "#/$defs/IssueStatus"
        },
        "proposed_by": {
          "enum": [
            "buyer",
            "seller",
            "auctioneer",
            "catalog"
          ]
        }
      },
      "required": [
        "status"
      ]
    },
    "HandlerId": {
      "type": "string",
      "pattern": "^(in\\.[a-z0-9_]+(\\.[a-z0-9_]+){0,3}|bacp\\.[a-z0-9_]+(\\.[a-z0-9_]+){0,2})$",
      "description": "Canonical payment-handler id. in.* = Indian rail or instrument, bacp.* = BACP-native construct."
    },
    "HandlerRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/HandlerId"
        },
        {
          "$ref": "common.json#/$defs/Handler"
        },
        {
          "$ref": "common.json#/$defs/RailType"
        }
      ],
      "description": "Canonical handler id, or a legacy alias kept for one deprecation window."
    },
    "RailTypeV1": {
      "type": "string",
      "description": "Handlers that may back an OPEN (HNP) payment mandate (binding class O). Supersedes the legacy RailType.",
      "pattern": "^(in\\.upi\\.(reservepay|circle|autopay|otm)|in\\.card\\.(mandate|agentic)|in\\.nach\\.debit|in\\.ppi\\.(wallet|gift|netc_topup|ncmc_topup)|in\\.store_credit|in\\.loyalty|in\\.erupi|in\\.cbdc\\.programmed|in\\.bbps\\.upms|bacp\\.credit_ledger|in\\.upi\\.uap\\.[a-z0-9_.]+|upi\\.circle\\.delegate|upi\\.reservepay\\.block|upi\\.autopay|upi\\.uap\\.[a-z0-9_.]+)$"
    },
    "UdyamCategory": {
      "enum": [
        "micro",
        "small",
        "medium",
        "none",
        "undeclared"
      ],
      "description": "MSMED Act s.15 applies to micro and small enterprises only."
    },
    "Party": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "buyer",
            "seller",
            "ordering_entity",
            "consignee",
            "paying_authority",
            "broker",
            "aggregator",
            "financier",
            "logistics",
            "assurer",
            "arbiter",
            "assisted_operator",
            "reseller",
            "auctioneer"
          ]
        },
        "id": {
          "type": "string",
          "description": "Beckn subscriber id, provider id, or pairwise pseudonymous principal ref. Never an Aadhaar number."
        },
        "legal_name": {
          "type": "string"
        },
        "gstin": {
          "type": "string",
          "pattern": "^[0-9]{2}[A-Z0-9]{10}[0-9A-Z]{3}$"
        },
        "udyam": {
          "type": "object",
          "properties": {
            "number": {
              "type": "string"
            },
            "category": {
              "$ref": "#/$defs/UdyamCategory"
            },
            "activity": {
              "enum": [
                "manufacturing",
                "services",
                "trading"
              ],
              "description": "MSMED s.15 applies to manufacturing and services micro/small units. Traders are likely excluded (2 Jul 2021 OM, to be verified)."
            },
            "declared_at": {
              "type": "string",
              "format": "date-time"
            },
            "evidence_hash": {
              "$ref": "common.json#/$defs/Hash"
            }
          },
          "required": [
            "category"
          ],
          "additionalProperties": false
        },
        "aato_band": {
          "enum": [
            "lt_5cr",
            "5cr_to_10cr",
            "gte_10cr",
            "unknown"
          ],
          "description": "Drives GST e-invoice (IRN) rules."
        },
        "kind": {
          "enum": [
            "agent",
            "human"
          ],
          "description": "offeror_kind disclosure."
        },
        "acts_for": {
          "type": "string",
          "description": "Role or party id this intermediary acts for."
        },
        "pricing_ai_vendor": {
          "type": "string",
          "description": "Third-party pricing or negotiation AI vendor."
        }
      },
      "required": [
        "role",
        "id"
      ],
      "additionalProperties": false
    },
    "DocumentRef": {
      "type": "object",
      "properties": {
        "doc_type": {
          "enum": [
            "rfq",
            "quotation",
            "proforma",
            "po",
            "order_ack",
            "tax_invoice",
            "credit_note",
            "debit_note",
            "delivery_challan",
            "e_way_bill",
            "grn",
            "prc",
            "crac",
            "weighment_slip",
            "assay_certificate",
            "inspection_report",
            "payment_advice",
            "tds_certificate",
            "e_nwr",
            "huid",
            "rera_agreement",
            "lc_document_set",
            "e_bg",
            "e_ticket",
            "rental_agreement",
            "scheme_claim",
            "ledger_confirmation",
            "auction_slip",
            "bid_document",
            "contract"
          ]
        },
        "id": {
          "type": "string"
        },
        "parent_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Typed document graph: e.g. GRN -> PO, invoice -> PO."
        },
        "issuer": {
          "type": "string"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "hash": {
          "$ref": "common.json#/$defs/Hash"
        },
        "irn": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "GST e-invoice IRN (64 hex)."
        },
        "signed_qr_hash": {
          "$ref": "common.json#/$defs/Hash"
        },
        "ewb_no": {
          "type": "string",
          "pattern": "^[0-9]{12}$"
        },
        "amount": {
          "$ref": "common.json#/$defs/Amount"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "doc_type",
        "id"
      ],
      "additionalProperties": false
    },
    "Citation": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "label": {
          "enum": [
            "RBI",
            "NPCI",
            "NBBL",
            "NET",
            "STATUTE",
            "GeM/DoE",
            "VENDOR",
            "PRESS",
            "SECONDARY",
            "K",
            "V",
            "UNVERIFIED",
            "ANALYSIS"
          ]
        }
      },
      "required": [
        "file",
        "section"
      ],
      "additionalProperties": false
    },
    "ProtocolVersion": {
      "type": "string",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2}|draft)$",
      "description": "BACP protocol version: a release date (YYYY-MM-DD) or \"draft\"."
    }
  }
}
