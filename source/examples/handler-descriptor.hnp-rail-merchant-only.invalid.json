    "basket_blind": true
  },
  "funding": "prepaid",
  "credit_disclosure_required": false,
  "segments": [
    "b2c"
  ],
  "requirements": [
    "PAY-119"
  ],
  "sources": [
    {
      "file": "RBI Master Direction on Prepaid Payment Instruments (RBI/DPSS/2021-22/82)",
      "section": "para 2.1",
      "label": "RBI"
