      "multi_capture": true
    }
  ],
  "limits": [
    {
      "name": "balance",
      "source": {
        "file": "RBI Master Direction on Prepaid Payment Instruments (RBI/DPSS/2021-22/82)",
        "section": "para 2.1",
        "label": "RBI"
      },
      "verification": "verified",
      "configurable": true,
      "applies_to": "merchant terms"
    }
  ],
  "afa": {
    "model": "n_a",
    "pre_debit_notice": "not_applicable",
    "source": {
      "file": "RBI Master Direction on Prepaid Payment Instruments (RBI/DPSS/2021-22/82)",
      "section": "para 2.1",
      "label": "RBI"
    }
  },
  "refund": {
    "route": "same_balance",
    "source": {
      "file": "RBI Master Direction on Prepaid Payment Instruments (RBI/DPSS/2021-22/82)",
      "section": "para 2.1",
      "label": "RBI"
    }
  },
  "dispute": {
